<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\arc.info" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ELFSharp" Version="2.17.3" />
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="NotEnoughLogs" Version="2.0.3" />
    <PackageReference Include="SCEToolSharp" Version="1.2.3" />
    <PackageReference Include="Sentry" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\External\SPRXPatcher\SPRXPatcher\SPRXPatcher.csproj" />
  </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources/CircleButton.sprx" Condition="Exists('Resources/CircleButton.sprx')">
            <LogicalName>CircleButton.sprx</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Resources/arc.info" Condition="Exists('Resources/arc.info')">
            <LogicalName>arc.info</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

</Project>
